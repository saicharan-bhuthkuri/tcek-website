# ==============================================================
# Security: Hardened Uploads Directory Policy
# Disables script execution, directory listings, and handler overrides
# ==============================================================

# Disable directory listing and script execution
Options -Indexes -ExecCGI

# Force Apache to treat all files as static downloads/streams
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .inc .cgi .pl .py .sh .bash
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .inc .cgi .pl .py .sh .bash
</IfModule>

# Force default static file handler
<IfModule mod_mime.c>
    SetHandler default-handler
</IfModule>

# Prevent MIME sniffing (e.g. executing HTML in images)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Explicitly deny access to script or executable extensions (Apache 2.2)
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|phps|pht|inc|cgi|pl|py|sh|bash|exe|bat|cmd|dll|jsp|asp|aspx|shtml|htaccess|htpasswd|config|env)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Explicitly deny access to script or executable extensions (Apache 2.4+)
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|phps|pht|inc|cgi|pl|py|sh|bash|exe|bat|cmd|dll|jsp|asp|aspx|shtml|htaccess|htpasswd|config|env)$">
        Require all denied
    </FilesMatch>
</IfModule>
