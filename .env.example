# ==============================================================
# Trinity College of Engineering & Technology (TCEK) Environment Config
# Rename this file to .env and configure your production values.
# NEVER commit the .env file with real credentials to source control!
# ==============================================================

# Application Environment (production, staging, development)
APP_ENV=development
APP_DEBUG=false
APP_URL=https://tcek.in

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tcek
DB_USER=tcek
DB_PASS=replace_with_strong_password_in_production
DB_CHARSET=utf8mb4

# Security & Session
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME_SECONDS=7200
CSRF_SECRET=generate_random_secret_for_csrf_signing

# Rate Limiting Configuration
# Authentication Routes (Login)
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=2
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_MAX_BACKOFF_SECONDS=900

# Public Endpoints (Website Browsing)
RATE_LIMIT_PUBLIC_MAX_REQUESTS=100
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# Authenticated User Actions (Admin Operations / CRUD)
RATE_LIMIT_AUTH_USER_MAX_REQUESTS=300
RATE_LIMIT_AUTH_USER_WINDOW_SECONDS=60

# File Upload Hardening Limits (in bytes)
UPLOAD_MAX_IMAGE_SIZE=10485760     # 10MB
UPLOAD_MAX_DOCUMENT_SIZE=26214400  # 25MB
UPLOAD_MAX_VIDEO_SIZE=104857600    # 100MB
